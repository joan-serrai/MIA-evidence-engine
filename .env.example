# Copia este archivo a ".env" y rellena los valores.
# El archivo .env NO se sube a git (contiene credenciales).

# Clave de la API de NCBI/PubMed (OPCIONAL: sube el límite de peticiones).
# Consíguela gratis en https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Dirección del servidor local de Ollama (por defecto este valor está bien)
OLLAMA_HOST=http://localhost:11434

# Clave de la API de OpenAI. SOLO se usa para la EVALUACIÓN comparativa
# (embeddings text-embedding-3-small = "línea Centivence"); el producto MIA sigue
# siendo 100% local. Consíguela en https://platform.openai.com/api-keys
# NUNCA subas esta clave a git (.env está en .gitignore).
OPENAI_API_KEY=
