# Copy this file to ".env". Nothing here is required to use MIA.
# .env is NOT committed to git (it may hold credentials).

# NCBI / PubMed API key (OPTIONAL: raises the request rate limit when building a corpus).
# Get one for free at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Address of the local Ollama server (the default is fine).
OLLAMA_HOST=http://localhost:11434

# Active domain profile (the slug of a domains/<slug>.json file).
# OPTIONAL: leave empty and MIA uses domains/active.txt (written by the app or by
# `build_corpus.py --activate`). With no profile at all, MIA opens on the Build corpus tab.
MIA_DOMAIN=

# OPTIONAL: offline mode for the embedding models. MedCPT is downloaded from HuggingFace
# once (about 840 MB); with this set to 1 the library never checks the internet again.
# HF_HUB_OFFLINE=1
