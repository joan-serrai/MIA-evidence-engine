# Copia este archivo a ".env" y rellena los valores.
# El archivo .env NO se sube a git (contiene credenciales).

# Clave de la API de NCBI/PubMed (OPCIONAL: sube el límite de peticiones).
# Consíguela gratis en https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Dirección del servidor local de Ollama (por defecto este valor está bien)
OLLAMA_HOST=http://localhost:11434

# Perfil de dominio (patología) activo: el slug de un archivo domains/<slug>.json.
# OPCIONAL: si se deja vacío, MIA usa domains/active.txt (lo escribe la app o
# `build_corpus.py --activate`) y, si tampoco existe, el perfil original
# `atopic_dermatitis`. Crea perfiles nuevos con `python build_corpus.py --help`.
MIA_DOMAIN=

# Clave de la API de OpenAI. SOLO se usa para la EVALUACIÓN comparativa
# (embeddings text-embedding-3-small = "línea Centivence"); el producto MIA sigue
# siendo 100% local. Consíguela en https://platform.openai.com/api-keys
# NUNCA subas esta clave a git (.env está en .gitignore).
OPENAI_API_KEY=

# OPCIONAL — modo sin red para los modelos de embeddings. La primera vez MedCPT se
# descarga de HuggingFace (unos 900 MB); a partir de ahí, con esta variable a 1,
# la librería no vuelve a consultar internet al cargar los modelos.
# HF_HUB_OFFLINE=1
